# DORA Universal Payment Mode Configuration
DORA_ENV=development
DORA_MODULE_NAME=dora-payments
DORA_MODULE_VERSION=0.1.0
SECRET_KEY=dora-dev-secret-key-change-in-production-123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=sqlite:///./dora_payments.db

# Payment Limits (in Paise: 1 INR = 100 Paise)
MAX_PER_TRANSACTION_LIMIT_PAISE=500000   # 5,000 INR
DAILY_LIMIT_PAISE=2000000               # 20,000 INR
PAYMENT_TIMEOUT_SECONDS=60

# PIN Security
MAX_PIN_ATTEMPTS=3
PIN_LOCKOUT_MINUTES=15

# UI Layout Defaults
DEFAULT_UI_MODE=watch                   # watch | hologram
WATCH_SCREEN_DIAMETER_PX=240
